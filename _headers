# Cloudflare Pages: header di sicurezza per tutto il sito spazio432.org
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# pagine con lo scanner QR: fotocamera permessa (solo dal sito stesso), fuori dai motori di ricerca
/admin*
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex

/prenotazioni*
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex

# altre pagine riservate: fuori dai motori di ricerca
/login*
  X-Robots-Tag: noindex

/finanze*
  X-Robots-Tag: noindex
